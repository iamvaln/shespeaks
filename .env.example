# --- Public URL of the site (used in emails: resume links, coach links) ---
APP_URL=https://your-site.vercel.app   # optional on Vercel (falls back to the Vercel URL, with a warning)

# --- Supabase Postgres ---
# Vercel/serverless: use the *Transaction pooler* connection string (Project Settings > Database > Connection pooling, port 6543).
# For `npm run db:migrate` the same URL works (or use the direct/session URL on port 5432).
# (Vercel's Supabase integration provides POSTGRES_URL instead; the app accepts either.)
DATABASE_URL=postgresql://postgres.xxxx:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# --- Supabase Storage (speaker photos, private bucket created automatically) ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # server-side only, never expose to the browser
SUPABASE_PHOTO_BUCKET=speaker-photos

# --- Secrets (generate with: openssl rand -hex 32) ---
SESSION_SECRET=change-me
CRON_SECRET=change-me                 # Vercel Cron sends it automatically as "Authorization: Bearer <CRON_SECRET>"

# --- First coach / admin (created by the seed step on deploy, or on first login, when no coach exists) ---
ADMIN_EMAIL=you@example.com
ADMIN_NAME=Valentine Nguemne

# --- Email via Resend (https://resend.com) ---
# Leave RESEND_API_KEY empty to only log emails (visible in Admin > Emails); nothing is sent.
RESEND_API_KEY=                       # starts with re_
# Must be an address on a domain you verified in Resend (Domains > Add domain, then add the DNS records).
# "onboarding@resend.dev" only delivers to your own Resend account email (testing).
MAIL_FROM="SheSpeaks <no-reply@yourdomain.com>"
# Optional: where candidates' replies go (e.g. the coach's inbox)
MAIL_REPLY_TO=

# --- AI title suggestions for the coaches (optional) ---
# Without a key the « Suggérer avec l'IA » button does not appear. Key from console.anthropic.com (starts with sk-ant-); set a spend limit there.
# Set it for the Production environment only: previews share the production database and would spend on the same key.
ANTHROPIC_API_KEY=

# --- Local development only: files go to ./data/uploads when SUPABASE_URL is empty ---
DATA_DIR=./data

# --- Database migrations on Vercel builds ---
# all (default): every build applies pending migrations before building. production: only production builds. false: never.
# MIGRATE_ON_BUILD=all
# Optional, migrations only: a direct / session-mode connection string if the pooler ever misbehaves for DDL.
# MIGRATE_DATABASE_URL=

# --- Optional: bypass the startup/build environment check (not recommended) ---
# SKIP_ENV_CHECK=true

# Contact checks on the first form screen (real mobile number via libphonenumber, email domain that takes mail).
# Default: on for the Vercel production deployment only. 1 = force on, 0 = force off.
# STRICT_CONTACT_CHECKS=
