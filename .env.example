# --- Public URL of the site (used in emails: resume links, coach links) ---
APP_URL=http://localhost:3000

# --- Secrets (generate with: openssl rand -hex 32) ---
SESSION_SECRET=change-me
CRON_SECRET=change-me

# --- First coach / admin, created automatically when the coaches table is empty ---
ADMIN_EMAIL=you@example.com
ADMIN_NAME=Valentine Nguemne

# --- Email (SMTP). Leave SMTP_HOST empty to only log emails (visible in Admin > Emails) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SheSpeaks <no-reply@example.com>"

# --- Storage (defaults to ./data) ---
DATA_DIR=./data

# --- Scheduler: set to "false" to disable the in-process reminder loop (use the cron endpoint instead) ---
ENABLE_SCHEDULER=true
