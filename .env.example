# --- Public URL of the site (used in emails: resume links, coach links) ---
APP_URL=https://your-site.vercel.app

# --- Supabase Postgres ---
# Vercel/serverless: use the *Transaction pooler* connection string (Project Settings > Database > Connection pooling, port 6543).
# For `npm run db:migrate` the same URL works (or use the direct/session URL on port 5432).
DATABASE_URL=postgresql://postgres.xxxx:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# --- Supabase Storage (speaker photos, private bucket created automatically) ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # server-side only, never expose to the browser
SUPABASE_PHOTO_BUCKET=speaker-photos

# --- Secrets (generate with: openssl rand -hex 32) ---
SESSION_SECRET=change-me
CRON_SECRET=change-me                 # Vercel Cron sends it automatically as "Authorization: Bearer <CRON_SECRET>"

# --- First coach / admin (created on first login or by `npm run db:migrate` when no coach exists) ---
ADMIN_EMAIL=you@example.com
ADMIN_NAME=Valentine Nguemne

# --- Email via Resend (https://resend.com) ---
# Leave RESEND_API_KEY empty to only log emails (visible in Admin > Emails); nothing is sent.
RESEND_API_KEY=                       # starts with re_
# Must be an address on a domain you verified in Resend (Domains > Add domain, then add the DNS records).
# "onboarding@resend.dev" only delivers to your own Resend account email (testing).
MAIL_FROM="SheSpeaks <no-reply@yourdomain.com>"
# Optional: where candidates' replies go (e.g. the coach's inbox)
MAIL_REPLY_TO=

# --- Local development only: files go to ./data/uploads when SUPABASE_URL is empty ---
DATA_DIR=./data

# --- Optional: bypass the startup/build environment check (not recommended) ---
# SKIP_ENV_CHECK=true
